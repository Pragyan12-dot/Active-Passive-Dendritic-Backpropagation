load_file("nrngui.hoc")


rm = 42000          // ohm-cm2
Cm_val = 1.25       // uF/cm2
soma_d = 18.8       //um
dend_d=2            //um
gNaBar = 0.12
gKBar  = 0.036
ena_val = 50        //mV
ek_val  = -77       //mV
Ra_val = 123        //ohm-cm

stamp = 1.2

//soma dend creation

create soma, dend

access soma

soma {
    L = soma_d
    diam = soma_d
    nseg = 1

    Ra = Ra_val
    cm = Cm_val
    insert hh
    gnabar_hh = gNaBar
    gkbar_hh = gKBar

    ena = ena_val
    ek  = ek_val
}

dend {
    L = 1000
    diam = dend_d
    nseg =int((L/(0.1*lambda_f(100))+0.9)/2)*2+1

    Ra = Ra_val
    cm = Cm_val
    insert minmax
    insert pas
    e_pas = -65
    g_pas = 1/rm
}
//connect soma and dend
connect dend(0), soma(1)

//Current Clamp
objref stim
soma stim = new IClamp(0.5)

stim.del = 100
stim.dur = 0.2
stim.amp = stamp


tstop = 1300
v_init = -65

//Action Potential Count
objref apc
soma apc = new APCount(0.5)

apc.thresh = 0

//procedure to count spike
proc spikk() {
    printf("Total spikes = %g\n", apc.n)
    printf("Injected current = %g nA\n\n", stim.amp)
}

//update functions
proc update_clamp() {
    stim.amp = stamp
}

//run model function
proc runmodel() {
    update_clamp()
    update_Rm()
    update_Ra()
    update_cm()
    finitialize(v_init)
    run()
    spikk()
}
//update parameter function
proc update_Rm() {
    dend g_pas = 1/rm
}

proc update_Ra() {
    dend Ra = Ra_val
}


proc update_cm() {
    dend cm = Cm_val
}

//peak voltage and latency function
objref vss

proc vssx() { local i, x, dist, vssr, tpeak

    vss = new Vector()

    for i=0, dend.nseg-1 {

        x = (i+0.5)/dend.nseg
        dist = x*dend.L

        if (stamp > 0) {
            vssr  = dend.vmax_minmax(x) - dend.e_pas(x)
            tpeak = dend.tmax_minmax(x)
        } else {
            vssr  = dend.vmin_minmax(x) - dend.e_pas(x)
            tpeak = dend.tmin_minmax(x)
        }

        printf("Distance = %6.2f um   Peak Voltage = %8.3f mV   Peak Time = %8.3f ms\n", dist, vssr, tpeak)

        vss.append(vssr)
    }

    printf("\n")
}



//GUI
xpanel("Parameters")
xvalue("Clamp Amplitude (nA)", "stamp", 1, "update_clamp()", 1, 1)
xvalue("Rm (ohm-cm2)", "rm", 1, "update_Rm()", 1, 1)
xvalue("Ra (ohm-cm)", "Ra_val", 1, "update_Ra()", 1, 1)
xvalue("Cm (uF/cm2)", "Cm_val", 1, "update_cm()", 1, 1)
xbutton("Run Simulation", "runmodel()")
xbutton("Peak time","vssx()")
xpanel()

nrncontrolmenu()

newPlotV()


runmodel()
