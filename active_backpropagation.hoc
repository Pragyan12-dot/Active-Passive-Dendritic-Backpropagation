load_file("nrngui.hoc")


rm = 42000          // ohm-cm2
Cm_val = 1.25       // uF/cm2
soma_d = 18.8       //um
dend_d=2            //um
gNaBar = 0.12       
gKBar  = 0.036
ena_val = 50        //mV
ek_val  = -77       //mV
Ra_val = 123        //ohm-cm

stamp = 1.6             //nA


//soma dend creation
create soma, dend

access soma

soma {
    L = soma_d
    diam = soma_d
    nseg = 1

    Ra = Ra_val
    cm = Cm_val
    insert hh
    gnabar_hh = gNaBar
    gkbar_hh = gKBar

    ena = ena_val
    ek  = ek_val
}
//active dendrites
dend {
    L = 1000
    diam = dend_d
    nseg = int((L/(0.1*lambda_f(100))+0.9)/2)*2+1

    Ra = Ra_val
    cm = Cm_val

    insert hh

    // Active channel densities
    gnabar_hh = 0.02
    gkbar_hh  = 0.01
    gl_hh     = 1/rm
    el_hh     = -65

    ena = ena_val
    ek  = ek_val

    insert minmax
}
//connect the dend and soma
connect dend(0), soma(1)

//Current Clamp
objref stim
soma stim = new IClamp(0.5)

stim.del = 100
stim.dur = 0.2
stim.amp = stamp


tstop = 1300
v_init = -65

//Count spikes
objref apc
soma apc = new APCount(0.5)

apc.thresh = 0

//Spike Count 
proc spikk() {
    printf("Total spikes = %g\n", apc.n)
    printf("Injected current = %g nA\n\n", stim.amp)
}
//update clamp
proc update_clamp() {
    stim.amp = stamp
}
//run model
proc runmodel() {
    update_clamp()
    update_Rm()
    update_Ra()
    update_cm()
    finitialize(v_init)
    run()
    spikk()
}
//update functions of different parameters
proc update_Rm() {

    
    dend gl_hh = 1/rm

}

proc update_Ra() {

    
    dend Ra = Ra_val

}


proc update_cm() {

    
    dend cm = Cm_val

}
//procedures for peak voltage and latency
objref vss

proc vssx() { local i, x, dist, vssr, tpeak

    vss = new Vector()

    for i=0, dend.nseg-1 {

        x = (i+0.5)/dend.nseg
        dist = x*dend.L

        if (stamp > 0) {
            vssr  = dend.vmax_minmax(x) - v_init
            tpeak = dend.tmax_minmax(x)
        } else {
            vssr  = dend.vmin_minmax(x) - v_init
            tpeak = dend.tmin_minmax(x)
        }

        printf("Distance = %6.2f um   Peak Voltage = %8.3f mV   Peak Time = %8.3f ms\n",dist, vssr, tpeak)

        vss.append(vssr)
    }

    printf("\n")
}

//GUI

xpanel("Parameters")
xvalue("Clamp Amplitude (nA)", "stamp", 1, "update_clamp()", 1, 1)
xvalue("Rm (ohm-cm2)", "rm", 1, "update_Rm()", 1, 1)
xvalue("Ra (ohm-cm)", "Ra_val", 1, "update_Ra()", 1, 1)
xvalue("Cm (uF/cm2)", "Cm_val", 1, "update_cm()", 1, 1)
xbutton("Run Simulation", "runmodel()")
xbutton("Peak time","vssx()")
xpanel()

nrncontrolmenu()

newPlotV()


runmodel()
